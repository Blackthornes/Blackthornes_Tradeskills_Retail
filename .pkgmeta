# Packaging instructions for the BigWigs packager, which builds the zip that
# CurseForge hands to players.
#
# The folder inside the zip must be named exactly as the .toc file, or the
# client will not see the addon.
package-as: Blackthornes_TS

# Development-only files. The README names the owner's own folders; players read
# the CurseForge description instead.
ignore:
  - .github
  - .gitattributes
  - .gitignore
  - .pkgmeta
  # Gets a cloud workspace ready to run the checks. Not for players.
  - .claude
  - docs
  - tools
  - deploy.ps1
  # Notes for Claude about working on the addon, shared with the other
  # addon's project. Not for players.
  - CLAUDE.md
  # The #general Discord posts; tools/post_general.py checks and posts them.
  - NEWS.md
  - README.md
  # Forever-only features and Classic travel routes that the Retail TOC
  # never loads. They stay in the repo so Forever changes merge cleanly.
  - Data/ForeverVendorSpots.lua
  - Data/ForeverRecipes.lua
  - Data/WaylaidCrates.lua
  - Data/CraftsmansWrits.lua
  - Data/Travel.lua
  - Data/TravelZones.lua
  - Logic/Legacy.lua
  - Logic/Travel.lua
  - Logic/MerchantsFavor.lua
  - Logic/Writs.lua
  - Logic/Contribute.lua
  - UI/FavorsView.lua
  - UI/TravelCard.lua
  - UI/TravelMap.lua
  - UI/DealsFavor.lua
  - UI/DealsWrits.lua
  - UI/Tab_Deals.lua
  # Classic data and Road to 300, which do not fit Retail. Learn next and
  # disenchanting learn from the game there instead.
  - Data/VendorPrices.lua
  - Data/VendorSpots.lua
  - Data/RecipeBook.lua
  - Data/LearnSpots.lua
  - Logic/RoadPlan.lua
  - Logic/Welcome.lua
  - UI/RoadView.lua
  - UI/Welcome.lua

# Ship CHANGELOG.md as written. Without this the packager writes its own from
# the full commit history, which is the private repository's development log
# and not something a player needs to read.
manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown
